# Local configuration and secrets: only templates are tracked.
env.local
.env
.env.*
!.env.example
# Generated and local state.
.aeion/
# Evaluation records grow with every run and stay on this machine.
tools/evals/results.jsonl
# .factory/ belongs to Factory's Droid; only its config is tracked, older local state stays ignored.
.factory/*
!.factory/settings.json
!.factory/README.md
# Active local recovery files; durable facts remain in knowledge/.
work/handovers/
/state_of_the_art research/
CLAUDE-SECURITY-*/
__pycache__/
*.pyc
.DS_Store
node_modules/
.venv/
# demo/: everything is tracked except each harness's working copy of the factory.
/demo/*/workspace/
/demo/*/workspace.run-*/

# A harness's live session log: it grows during a run, so it is not part of the project tree (and would
# stale every checkpoint receipt).
/demo/*/journal/*.jsonl
/demo/*/archive/*/journal/*.jsonl
# Rendered Archify/Graphify HTML is rebuilt from its diagram JSON (tools/architecture/gallery), never tracked.
/demo/*/render/**/*.html
/demo/*/archive/*/render/**/*.html
