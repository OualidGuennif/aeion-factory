# Local configuration and secrets: only templates are tracked.
env.local
.env
.env.*
!.env.example
# Generated and local state.
.aeion/
# .factory/ belongs to Factory's Droid; only its config is tracked, older local state stays ignored.
.factory/*
!.factory/settings.json
!.factory/README.md
# Active local recovery files; durable facts remain in knowledge/.
work/handovers/
/state_of_the_art research/
CLAUDE-SECURITY-*/
__pycache__/
*.pyc
.DS_Store
node_modules/
.venv/
# demo/: everything is tracked except each harness's working copy of the factory.
/demo/*/workspace/

# The live dsh session log of the demo: it grows during a run, so it is not part of the project tree.
demo/dsh/journal/run.jsonl
