#!/usr/bin/env python3
"""The demo's self-check: every AxiomSpec step of Æion Factory, replayed on a fresh copy, no agent needed.

    demo/check              build a copy, install the Holiday Planner, run every step, report each one
    demo/check --keep       keep the copy and print its path, to inspect or to start a harness round in it
    demo/check --refresh    rewrite demo/holiday-planner/features/ from the spec, then check

Python 3 only. Exit 0 when every step passes, 1 otherwise."""
import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

FACTORY = Path(__file__).resolve().parents[1]
PLANNER = FACTORY / "demo/holiday-planner"
SECTIONS = ["## Intent", "## Data sources", "## Inputs", "## Outputs", "## Invariants", "## Determinism",
            "## Acceptance checks", "## Out of scope"]
sys.path.insert(0, str(FACTORY / ".claude/hooks"))
from project_files import project_files  # noqa: E402


class Check:
    """Runs commands in the copy and records one PASS or FAIL line per step."""

    def __init__(self, root):
        self.root, self.results = root, []

    def run(self, *args, cwd=None):
        return subprocess.run([sys.executable, *args], cwd=cwd or self.root, capture_output=True, text=True, timeout=300)

    def axiom(self, *args):
        return self.run(str(self.root / "tools/axiom/axiom"), *args)

    def step(self, title, ok, detail=""):
        self.results.append(ok)
        print(f"{'PASS' if ok else 'FAIL'}  {len(self.results):>2}. {title}" + (f"  ({detail})" if detail else ""))
        return ok


def copy_factory(target):
    """The factory as a new user receives it: tracked and untracked files, without demo/ or local state."""
    for rel in project_files(FACTORY, untracked=True):
        source = FACTORY / rel
        if rel.startswith(("demo/", ".aeion/")) or not (source.is_file() or source.is_symlink()):
            continue
        destination = target / rel
        destination.parent.mkdir(parents=True, exist_ok=True)
        # Links stay links: CLAUDE.md points at AGENTS.md and .agents/skills/* at .claude/skills/*.
        if source.is_symlink():
            os.symlink(os.readlink(source), destination)
        else:
            shutil.copy2(source, destination)


def install(source, target):
    for rel in ("knowledge/spec/spec.json", "docs/view-catalog.json", "docs/feature-catalog.json", "docs/authored/brief.md"):
        (target / rel).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source / rel, target / rel)
    shutil.rmtree(target / "docs/views", ignore_errors=True)
    shutil.copytree(source / "docs/views", target / "docs/views")


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--keep", action="store_true")
    parser.add_argument("--refresh", action="store_true")
    args = parser.parse_args(argv)
    started = time.time()
    folder = Path(tempfile.mkdtemp(prefix="aeion-demo-"))
    root = folder / "holiday-planner"
    root.mkdir()
    check = Check(root)
    try:
        return scenario(check, root, args)
    finally:
        print(f"demo/check: {sum(check.results)} of {len(check.results)} steps passed in {time.time() - started:.1f}s"
              + (f"; copy kept at {root}" if args.keep else ""))
        if not args.keep:
            shutil.rmtree(folder, ignore_errors=True)


def scenario(check, root, args):
    # 1. A new project from the factory: its own empty spec and cockpit, every gate green.
    copy_factory(root)
    done = check.run(str(root / "tools/release/release"), "--new-project")
    spec = json.loads((root / "knowledge/spec/spec.json").read_text()) if (root / "knowledge/spec/spec.json").is_file() else {}
    check.step("new project: own spec skeleton and cockpit", done.returncode == 0
               and spec.get("project", {}).get("name") == root.name and (root / "docs/README.md").is_file(), done.stderr.strip()[:120])
    done = check.axiom("check")
    check.step("new project passes axiom check", done.returncode == 0, done.stdout.strip().splitlines()[-1] if done.stdout else "")

    # 2. The Holiday Planner's canonical spec: gates G01-G07, scenarios evaluated.
    install(PLANNER, root)
    done = check.axiom("validate")
    check.step("Holiday Planner spec is design_ready", done.returncode == 0 and "design_ready: pass" in done.stdout,
               done.stdout.splitlines()[0] if done.stdout else done.stderr[:120])
    done = check.axiom("validate", "--json")
    report = json.loads(done.stdout) if done.stdout.startswith("{") else {}
    check.step("report is axiomspec-report/0.2, every gate named", report.get("format") == "axiomspec-report/0.2"
               and {c["gate"] for c in report.get("checks", [])} == {f"G0{n}" for n in range(1, 8)})

    # 3. The cockpit: pages, six diagrams, the open decision in view.
    done = check.axiom("docs")
    cockpit = (root / "docs/README.md").read_text() if (root / "docs/README.md").is_file() else ""
    diagrams = sorted(p.name for p in (root / "docs/generated/diagrams").glob("*.svg"))
    check.step("cockpit generated with six diagrams and DEC-006 open", done.returncode == 0 and len(diagrams) == 6
               and "DEC-006" in cockpit and "Design readiness: **pass**" in cockpit, f"{len(diagrams)} diagrams")
    done = check.axiom("check")
    check.step("axiom check passes on the planner", done.returncode == 0, done.stdout.strip().splitlines()[-1] if done.stdout else "")

    # 4. The 20 feature specs a build factory receives, identical to the committed ones.
    out = root / "docs/features"
    done = check.axiom("export", "--all", "--out", str(out))
    files = sorted(out.glob("*.md"))
    well_formed = all([line for line in f.read_text().split("\n") if line.startswith("## ")] == SECTIONS
                      and "- [ ] " in f.read_text() and f.stat().st_size <= 12000 for f in files)
    check.step("20 features exported: eight sections, checks, <= 12,000 bytes", done.returncode == 0 and len(files) == 20
               and well_formed, f"{len(files)} files, largest {max((f.stat().st_size for f in files), default=0)} bytes")
    committed = PLANNER / "features"
    if args.refresh:
        shutil.rmtree(committed, ignore_errors=True)
        shutil.copytree(out, committed)
    stale = [f.name for f in files if not (committed / f.name).is_file() or (committed / f.name).read_bytes() != f.read_bytes()]
    check.step("committed feature files are current", not stale, f"stale: {', '.join(stale[:3])}" if stale else "")

    # 5. The graph and an agent's questions: requirement closure, context packet, gaps.
    done = check.axiom("query", "--json", "requirement", "REQ-010")
    items = {i.get("id") for i in json.loads(done.stdout)["items"]} if done.returncode == 0 else set()
    check.step("query requirement REQ-010: its constraints, tests and decision", {"CON-001", "CON-002", "TEST-014", "TEST-016",
               "GOAL-006"} <= items, f"{len(items)} items")
    done = check.axiom("packet", "--ids", "REQ-010", "--json")
    packet = json.loads(done.stdout) if done.stdout.startswith("{") else {}
    ids = {i["id"] for p in packet.get("parts", []) for i in p["items"]}
    check.step("packet for REQ-010 is complete and carries the hard project rule CON-004", packet.get("status") == "complete"
               and {"CON-001", "CON-002", "CON-004", "REQ-008", "TERM-004", "ENV-001"} <= ids, f"{len(ids)} items")

    # 6. A real slice: code and tests land, bindings resolve, the adapter runs them, receipts are current.
    shutil.copytree(PLANNER / "reference/app", root / "app", dirs_exist_ok=True,
                    ignore=shutil.ignore_patterns("__pycache__"))
    shutil.copy2(PLANNER / "reference/knowledge/components/schedule.md", root / "knowledge/components/schedule.md")
    done = check.axiom("query", "spec", "app/domain/schedule.py")
    check.step("the slice links both ways: doc, Spec header and COMP-002", done.returncode == 0
               and "knowledge/components/schedule.md" in done.stdout and "COMP-002" in done.stdout)
    done = check.axiom("evidence", "run", "--ids", "TEST-012,TEST-013,TEST-014,TEST-015")
    check.step("evidence run: four bound tests pass with receipts", done.returncode == 0 and done.stdout.count(": pass") == 4)
    done = check.axiom("validate", "--phase", "implementation", "--json")
    gaps = {c["subject_id"] for c in json.loads(done.stdout)["checks"] if c["gate"] == "G10" and c["status"] != "pass"}
    check.step("implementation gates: the slice is executed, the rest honestly unknown", not gaps & {"TEST-012", "TEST-013",
               "TEST-014", "TEST-015"} and "TEST-001" in gaps and done.returncode == 3, f"{len(gaps)} test cases not executed")

    # 7. The faults the checks exist for: stale evidence, a dangling ID, a hand-edited page.
    target = root / "app/domain/schedule.py"
    target.write_text(target.read_text() + "\n# a later change\n")
    done = check.axiom("evidence", "check")
    check.step("a code change makes the receipts stale", done.returncode == 2 and "stale" in done.stdout)
    extra = root / "knowledge/components/extra.md"
    extra.write_text("# Extra\n\nThis cites REQ-404 in prose.\n")
    done = check.axiom("check")
    check.step("a dangling canonical ID fails axiom check", done.returncode == 2 and "REQ-404" in done.stdout)
    extra.unlink()
    page = root / "docs/generated/product/overview.md"
    page.write_text(page.read_text() + "\nhand edit\n")
    done = check.axiom("check")
    check.step("a hand-edited generated page fails axiom check", done.returncode == 2 and "overview.md" in done.stdout)
    check.axiom("docs")

    # 8. The factory's own checks still hold on the finished project.
    names = ("tools/knowledge/knowledge-check", "tools/knowledge/doc-links", "tools/repo-health/repo-health", "tools/axiom/axiom")
    failed = [n for n in names if check.run(str(root / n), *(["check"] if n.endswith("axiom") else [])).returncode]
    check.step("knowledge-check, doc-links, repo-health and axiom check pass", not failed, ", ".join(failed))
    return 0 if all(check.results) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
