{
  "format": "aeion-view/0.1",
  "kind": "state",
  "direction": "LR",
  "states": [
    "RUNNING",
    "HANDOVER_REQUIRED",
    "CHECKPOINTED",
    "RECOVERING",
    "STOPPED"
  ],
  "initial": "RUNNING",
  "final": [
    "STOPPED"
  ],
  "transitions": [
    {
      "from": "RUNNING",
      "to": "HANDOVER_REQUIRED",
      "label": "usage reaches 250k"
    },
    {
      "from": "HANDOVER_REQUIRED",
      "to": "CHECKPOINTED",
      "label": "verified handover"
    },
    {
      "from": "CHECKPOINTED",
      "to": "RECOVERING",
      "label": "compaction"
    },
    {
      "from": "RECOVERING",
      "to": "RUNNING",
      "label": "new positive usage"
    },
    {
      "from": "HANDOVER_REQUIRED",
      "to": "STOPPED",
      "label": "300k or invalid usage"
    }
  ]
}
