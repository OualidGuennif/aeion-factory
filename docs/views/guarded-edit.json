{
  "format": "aeion-view/0.1",
  "kind": "sequence",
  "participants": [
    {
      "id": "agent",
      "label": "Coding agent",
      "type": "actor"
    },
    {
      "id": "harness",
      "label": "Harness"
    },
    {
      "id": "guard",
      "label": "Shared guards"
    },
    {
      "id": "repo",
      "label": "Project files",
      "type": "store"
    }
  ],
  "steps": [
    {
      "from": "agent",
      "to": "harness",
      "label": "tool call (shell or file edit)"
    },
    {
      "from": "harness",
      "to": "guard",
      "label": "PreToolUse event"
    },
    {
      "fragment": "alt",
      "branches": [
        {
          "label": "secret read, force-push or hook bypass",
          "steps": [
            {
              "from": "guard",
              "to": "harness",
              "label": "refuse with the rule and its fix",
              "kind": "reply"
            },
            {
              "from": "harness",
              "to": "agent",
              "label": "refusal, nothing ran",
              "kind": "reply"
            }
          ]
        },
        {
          "label": "allowed",
          "steps": [
            {
              "from": "harness",
              "to": "repo",
              "label": "run the tool"
            },
            {
              "from": "harness",
              "to": "guard",
              "label": "PostToolUse: after-edit checks"
            },
            {
              "from": "guard",
              "to": "agent",
              "label": "fast check result and the covering doc",
              "kind": "reply"
            }
          ]
        }
      ]
    },
    {
      "note": "The pre-commit hook and CI repeat the checks, including axiom check",
      "over": [
        "guard",
        "repo"
      ]
    }
  ]
}
