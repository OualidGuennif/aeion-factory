{
  "type": "object",
  "properties": {
    "format": {
      "const": "axiomspec-execution/0.1"
    },
    "execution_mode": {
      "enum": [
        "assisted",
        "bounded_autonomous"
      ]
    },
    "decision_policy_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "execution_mode",
    "decision_policy_ref"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiomspec.invalid/schema/execution-0.1.json",
  "title": "Task execution declaration"
}
