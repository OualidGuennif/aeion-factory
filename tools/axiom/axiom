#!/usr/bin/env python3
# Spec: knowledge/components/axiom-toolkit.md
"""axiom: the AxiomSpec engine of Æion Factory, Python standard library only.

    tools/axiom/axiom [--root DIR] [--spec PATH] <command> ...    (tools/axiom/axiom <command> --help)

Exit codes: validate/check 0 pass, 2 fail, 3 unknown, 4 input error; queries 0 answer, 3 ambiguous,
4 not found, 1 graph unavailable. No model, no network; a spec is data, never instructions."""
import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import common  # noqa: E402
import spec as specs  # noqa: E402

EXIT = {"pass": 0, "fail": 2, "unknown": 3, "error": 4}


def main(argv):
    parser = argparse.ArgumentParser(prog="axiom", description=__doc__.split("\n")[0])
    parser.add_argument("--root", type=Path, default=common.ROOT, help="project root (default: this factory copy)")
    parser.add_argument("--spec", type=Path, help="canonical spec (default: <root>/knowledge/spec/spec.json)")
    commands = parser.add_subparsers(dest="command", required=True)
    init = commands.add_parser("init", help="write a draft spec skeleton and the catalogs")
    init.add_argument("--name", default=None)
    init.add_argument("--owner-role", default="Product owner")
    validate = commands.add_parser("validate", help="design gates G01-G07 (and G09-G11 for implementation)")
    validate.add_argument("--phase", choices=("design", "implementation"), default="design")
    validate.add_argument("--evaluated-at", help="UTC instant for effective windows (ISO 8601)")
    validate.add_argument("--json", action="store_true")
    validate.add_argument("--report", type=Path, help="also write the axiomspec-report/0.2 here")
    evaluate = commands.add_parser("evaluate", help="BCIR constraints on observation cases")
    evaluate.add_argument("--observations", type=Path, required=True)
    evaluate.add_argument("--evaluated-at", help="UTC instant for effective windows (ISO 8601)")
    evaluate.add_argument("--json", action="store_true")
    graph = commands.add_parser("graph", help="rebuild the knowledge graph snapshot when inputs changed")
    graph.add_argument("--json", action="store_true")
    graph.add_argument("--force", action="store_true")
    query = commands.add_parser("query", help="bounded answers from the graph")
    query.add_argument("kind", choices=("node", "requirement", "impact", "gaps", "find", "deps", "rdeps", "path",
                                        "tests", "untested", "spec", "files", "hubs", "status", "search"))
    query.add_argument("args", nargs="*")
    query.add_argument("--depth", type=int, default=1)
    query.add_argument("--top", type=int, default=15)
    query.add_argument("--json", action="store_true")
    query.add_argument("--all", action="store_true", help="lift the 40-line text cap")
    packet = commands.add_parser("packet", help="mandatory context closure for a change")
    packet.add_argument("--ids", default="", help="comma-separated canonical IDs")
    packet.add_argument("--files", default="", help="comma-separated changed files")
    packet.add_argument("--budget-bytes", type=int, default=32768)
    packet.add_argument("--out", type=Path)
    packet.add_argument("--json", action="store_true")
    for name, text in (("views", "render diagram sources to SVG"), ("docs", "regenerate the cockpit and pages")):
        sub = commands.add_parser(name, help=text)
        sub.add_argument("--check", action="store_true", help="fail when generated files are stale")
    export = commands.add_parser("export", help="feature Markdown per goal (eight spec sections)")
    export.add_argument("--goal")
    export.add_argument("--all", action="store_true")
    export.add_argument("--profile", type=Path, help="frontmatter profile (aeion-export-profile/0.1)")
    export.add_argument("--out", type=Path)
    evidence = commands.add_parser("evidence", help="run bound unittest tests or check receipts")
    evidence.add_argument("action", choices=("run", "check"))
    evidence.add_argument("--ids", default="")
    commands.add_parser("check", help="the commit/CI gate")
    # AxiomSpec's proposed interface puts --spec after the command (`axiom validate --spec spec.json`);
    # both places work, and a value given after the command wins.
    for command in commands.choices.values():
        command.add_argument("--spec", type=Path, default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    args.root = args.root.resolve()
    args.spec = (args.spec if args.spec else args.root / common.SPEC_PATH).resolve()
    return globals()["cmd_" + args.command](args)


def now():
    return datetime.now(timezone.utc).isoformat()


# The observation file: its shape is checked before any value is used.
OBSERVATIONS = {"type": "object", "required": ["cases"], "properties": {"cases": {"type": "array", "maxItems": 10000, "items": {
    "type": "object", "required": ["scenario_id", "environment_id", "environment", "expected"],
    "properties": {"scenario_id": {"type": "string"}, "environment_id": {"type": "string"}, "environment": {"type": "object"},
                   "expected": {"type": "object", "additionalProperties": {"type": "boolean"}}}}}}}


def bad_instant(args):
    """An input error message when --evaluated-at is given but is not a UTC instant, else None."""
    value = getattr(args, "evaluated_at", None)
    if value is None:
        return None
    try:
        specs.utc_instant(value)
    except ValueError:
        return f"error EVALUATED_AT: {value!r} is not a UTC instant (for example 2026-11-10T00:00:00Z)"
    return None


def load(args, result):
    """The validated spec and its model, or None when G01 failed (diagnostics are in result)."""
    if not args.spec.is_file():
        result.add("G01", "error", "MISSING_SPEC", f"{args.spec} does not exist (run: tools/axiom/axiom init)")
        return None, None
    spec = specs.load_spec(args.spec, result)
    if spec is None:
        return None, None
    evaluated_at = getattr(args, "evaluated_at", None)
    model, _ = specs.validate(spec, evaluated_at=evaluated_at, result=result)
    return spec, model


def cmd_validate(args):
    if bad_instant(args):
        print(bad_instant(args), file=sys.stderr)
        return 4
    result = specs.Result()
    spec, model = load(args, result)
    gates = list(specs.DESIGN_GATES)
    limits = []
    if args.phase == "implementation" and model is not None:
        import evidence
        evidence.implementation_gates(args.root, model, result, args.spec)
        gates += ["G08", "G09", "G10", "G11", "G12"]
        limits.append("G08 and G12 need trusted principal, policy and authority adapters, which do not exist here.")
    phase = "design_ready" if args.phase == "design" else "implementation_accepted"
    report = specs.report(result, phase, gates, model.digest if model else None, now(), limits,
                          scope="baseline" if args.phase == "design" else "implementation")
    if args.report:
        common.write_atomic(args.report, common.pretty(report))
    if args.json:
        print(json.dumps(report, indent=2, ensure_ascii=False))
        return EXIT[report["status"]]
    project = spec["project"] if spec else {}
    print(f"{phase}: {report['status']}   spec {(model.digest[:12] if model else 'not loaded')}"
          + (f"   {project['id']} '{project['name']}' ({project['mode']})" if project else ""))
    for gate in gates:
        listed = [d for d in result.diagnostics if d["gate"] == gate]
        print(f"  {gate} {result.gate_status(gate):<7} {specs.GATE_TITLES[gate]}"
              + (f"  ({len(listed)} diagnostic{'s' if len(listed) != 1 else ''})" if listed else ""))
    shown = sorted(result.diagnostics, key=lambda d: (d["gate"], -specs.SEVERITY[d["status"]], d["subject_id"] or ""))
    for d in shown[:60]:
        print(f"    {d['gate']} {d['status']:<7} {d['code']:<26} {d['subject_id'] or '-':<11} {d['message']}")
    if len(shown) > 60:
        print(f"    ... {len(shown) - 60} more (--json lists every diagnostic)")
    return EXIT[report["status"]]


def cmd_evaluate(args):
    import bcir
    from schema import Validator
    if bad_instant(args):
        print(bad_instant(args), file=sys.stderr)
        return 4
    result = specs.Result()
    spec, model = load(args, result)
    if model is None:
        return _fail_load(result)
    from strict import InputError, load as strict_load
    try:
        fixtures = strict_load(args.observations)
    except InputError as error:
        print(f"error {error.code}: {error.message}", file=sys.stderr)
        return 4
    shape_errors = Validator(OBSERVATIONS).errors(fixtures)
    if shape_errors:
        print(f"error OBSERVATIONS: {shape_errors[0][0] or '/'}: {shape_errors[0][1]}", file=sys.stderr)
        return 4
    unknown_envs = sorted({c["environment_id"] for c in fixtures["cases"]} - set(model.envs))
    if unknown_envs:
        print(f"error OBSERVATIONS: unknown environment(s) {', '.join(unknown_envs)}", file=sys.stderr)
        return 4
    rows, problems = [], []
    scenarios = {n["id"]: n for n in model.active("Scenario")}
    covered = []
    for case in fixtures["cases"]:
        scenario = scenarios.get(case.get("scenario_id"))
        if scenario is None:
            problems.append(f"{case.get('scenario_id')}: no active scenario")
            continue
        covered.append(scenario["id"])
        env = model.envs[case["environment_id"]]
        refused = None
        if env["id"] in getattr(model, "broken_envs", ()):
            # G03 rejected the environment: nothing can be evaluated in it, so every row is unknown.
            refused = ("unknown", f"{env['id']} failed G03; not evaluated")
        else:
            try:
                validator = bcir.environment_validator(env)
            except (bcir.AnalysisError, RecursionError, TypeError, AttributeError) as error:
                refused = ("error", f"the environment schema cannot validate data: {type(error).__name__}")
        declared = {e["constraint_id"]: e["expected"] for e in scenario["data"]["constraint_expectations"]}
        if declared != case["expected"]:
            problems.append(f"{scenario['id']}: observation expectations differ from the scenario's")
        active = {n["id"] for n in model.active("Constraint") if n["data"]["representation"] == "bcir"
                  and n["data"]["environment_id"] == env["id"]}
        if set(case["expected"]) != active:
            problems.append(f"{scenario['id']}: expectations must cover exactly the active BCIR constraints of {env['id']}")
        for constraint_id, expected in sorted(case["expected"].items()):
            if refused:
                rows.append({"scenario": scenario["id"], "constraint": constraint_id, "expected": expected,
                             "status": refused[0], "detail": refused[1]})
                continue
            try:
                outcome = specs.expectation_outcome(model, scenario, {"constraint_id": constraint_id, "expected": expected},
                                                    validator, getattr(args, "evaluated_at", None), case["environment"])
            except (bcir.AnalysisError, RecursionError, TypeError, AttributeError) as error:
                outcome = ("error", "EVALUATION_ERROR", f"{constraint_id}: {type(error).__name__}")
            rows.append({"scenario": scenario["id"], "constraint": constraint_id, "expected": expected,
                         "status": "match" if outcome is None else outcome[0], "detail": outcome[2] if outcome else ""})
    missing = sorted(set(scenarios) - set(covered))
    duplicate = sorted({s for s in covered if covered.count(s) > 1})
    problems += [f"{s}: no observation case" for s in missing] + [f"{s}: duplicate observation case" for s in duplicate]
    worst = max([r["status"] for r in rows if r["status"] != "match"] + (["fail"] if problems else []),
                key=lambda s: specs.SEVERITY.get(s, 0), default="pass")
    if args.json:
        print(json.dumps({"status": worst, "expectations": rows, "problems": problems}, indent=2))
        return EXIT[worst]
    matched = sum(1 for r in rows if r["status"] == "match")
    print(f"evaluate: {worst}   {matched} of {len(rows)} expectations match across {len(covered)} observations"
          + (" (synthetic fixtures)" if fixtures.get("synthetic") else ""))
    for row in rows:
        if row["status"] != "match":
            print(f"  {row['status']:<7} {row['scenario']} {row['constraint']}: {row['detail']}")
    for problem in problems:
        print(f"  fail    {problem}")
    return EXIT[worst]


def _fail_load(result):
    for d in result.diagnostics:
        print(f"{d['gate']} {d['status']} {d['code']} {d['pointer']}: {d['message']}", file=sys.stderr)
    return 4


def cmd_init(args):
    import docs
    return docs.init(args.root, args.spec, args.name, args.owner_role)


def cmd_graph(args):
    import graph
    snapshot = graph.snapshot(args.root, args.spec, force=args.force)
    summary = graph.summary(snapshot)
    print(json.dumps(summary, indent=2) if args.json else graph.summary_text(summary))
    return 0


def cmd_query(args):
    import graph
    import query
    try:
        snapshot = graph.snapshot(args.root, args.spec)
    except graph.GraphError as error:
        print(f"graph unavailable: {error}", file=sys.stderr)
        return 1
    response, code = query.run(snapshot, args.kind, args.args, depth=args.depth, top=args.top)
    print(json.dumps(response, indent=2, ensure_ascii=False) if args.json
          else query.text(response, cap=None if args.all else 40))
    return code


def cmd_packet(args):
    import graph
    import query
    snapshot = graph.snapshot(args.root, args.spec)
    ids = [i for i in args.ids.split(",") if i]
    files = [f for f in args.files.split(",") if f]
    packet = query.packet(snapshot, ids, files, args.budget_bytes)
    rendered = json.dumps(packet, indent=2, ensure_ascii=False) if args.json else query.packet_markdown(packet)
    if args.out:
        common.write_atomic(args.out, rendered + "\n")
        print(f"packet: {packet['status']}, {len(packet['parts'])} part(s), closure {packet['closure_sha256'][:12]} -> {args.out}")
    else:
        print(rendered)
    return 0 if packet["status"] == "complete" else 3


def cmd_views(args):
    import views
    problems = views.render_all(args.root, check=args.check)
    for problem in problems:
        print(problem, file=sys.stderr)
    return 2 if problems else 0


def cmd_docs(args):
    import docs
    result = specs.Result()
    spec, model = load(args, result)
    problems = docs.generate(args.root, spec, model, result, check=args.check)
    for problem in problems:
        print(problem, file=sys.stderr)
    if not problems:
        print("docs: current" if args.check else f"docs: written ({common.COCKPIT}, {common.GENERATED}/)")
    return 2 if problems else 0


def cmd_export(args):
    import docs
    result = specs.Result()
    spec, model = load(args, result)
    if model is None:
        return _fail_load(result)
    return docs.export(args.root, model, args.goal, args.all, args.profile, args.out)


def cmd_evidence(args):
    import evidence
    result = specs.Result()
    spec, model = load(args, result)
    if model is None:
        return _fail_load(result)
    ids = [i for i in args.ids.split(",") if i]
    return evidence.run(args.root, model, ids) if args.action == "run" else evidence.check(args.root, model)


def cmd_check(args):
    import docs
    import views
    result = specs.Result()
    problems = []
    spec, model = load(args, result) if args.spec.is_file() else (None, None)
    # Structure and references block a commit; readiness (decisions, tests, an empty baseline) is reported.
    blocking = [d for d in result.diagnostics if d["gate"] in ("G01", "G02", "G03") and d["status"] == "error"
                or d["gate"] == "G02" and d["status"] == "fail" and d["code"] != "EMPTY_BASELINE"]
    problems += [f"{d['gate']} {d['code']} {d['subject_id'] or ''} {d['pointer']}: {d['message']}" for d in blocking]
    problems += docs.dangling_ids(args.root, model, args.spec)
    # docs covers the diagrams too; without a spec only the views can be checked.
    if spec is not None:
        problems += docs.generate(args.root, spec, model, result, check=True)
    else:
        problems += views.render_all(args.root, check=True)
    for problem in problems:
        print(f"FAIL {problem}")
    design = result.phase(specs.DESIGN_GATES) if spec else "unknown"
    state = "no knowledge/spec/spec.json" if spec is None and not args.spec.is_file() else f"design_ready {design}"
    print(f"axiom check: {'FAIL' if problems else 'PASS'} ({state})")
    return 2 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
