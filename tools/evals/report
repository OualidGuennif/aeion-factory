#!/usr/bin/env python3
# Spec: knowledge/operations/evals.md
"""Summarize evaluation records by harness: runs, success rate, median minutes, cost and defects."""
import argparse
import json
from pathlib import Path
import statistics
import sys

ROOT = Path(__file__).resolve().parents[2]
DEFAULT_FILE = "tools/evals/results.jsonl"
COLUMNS = ("Harness", "Runs", "Successes", "Success rate", "Median minutes", "Cost USD",
           "Human interventions", "Defects after done")


def target(value):
    path = Path(value)
    return path if path.is_absolute() else ROOT / path


def number(record, key):
    value = record.get(key)
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return 0.0
    return float(value)


def summarize(name, rows):
    runs = len(rows)
    successes = sum(1 for row in rows if row.get("success") is True)
    minutes = [number(row, "minutes") for row in rows]
    return {
        "harness": name,
        "runs": runs,
        "successes": successes,
        "success_rate": round(100 * successes / runs) if runs else 0,
        "median_minutes": round(statistics.median(minutes), 1) if minutes else 0.0,
        "cost_usd": round(sum((number(row, "cost_usd") for row in rows), 0.0), 2),
        "human_interventions": int(sum(number(row, "human_interventions") for row in rows)),
        "defects_after_done": int(sum(number(row, "defects_after_done") for row in rows)),
    }


def load(path):
    if not path.is_file():
        print(f"FAIL {path}: no evaluation records file; record one first", file=sys.stderr)
        sys.exit(2)
    records = []
    for index, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError as error:
            print(f"FAIL {path}:{index}: malformed JSON record ({error.msg})", file=sys.stderr)
            sys.exit(2)
        if not isinstance(record, dict) or not isinstance(record.get("harness"), str):
            print(f"FAIL {path}:{index}: a record needs a string 'harness'", file=sys.stderr)
            sys.exit(2)
        records.append(record)
    return records


def grouped(records):
    names = sorted({row["harness"] for row in records})
    return [summarize(name, [row for row in records if row["harness"] == name]) for name in names]


def cells(row):
    return (row["harness"], str(row["runs"]), str(row["successes"]), f"{row['success_rate']}%",
            f"{row['median_minutes']:.1f}", f"{row['cost_usd']:.2f}",
            str(row["human_interventions"]), str(row["defects_after_done"]))


def markdown(rows):
    lines = ["| " + " | ".join(COLUMNS) + " |", "|" + "|".join(" --- " for _ in COLUMNS) + "|"]
    lines += ["| " + " | ".join(cells(row)) + " |" for row in rows]
    return "\n".join(lines)


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--file", default=DEFAULT_FILE, help="JSONL file, absolute or from the repository root")
    parser.add_argument("--json", action="store_true", help="one JSON object instead of the table")
    args = parser.parse_args(argv)

    records = load(target(args.file))
    rows = grouped(records)
    if args.json:
        print(json.dumps({"harnesses": rows, "all": summarize("All", records)}, indent=2))
        return 0
    if not records:
        print("No evaluation records.")
        return 0
    print(markdown([*rows, summarize("All", records)]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
