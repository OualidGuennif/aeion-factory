#!/usr/bin/env bash
# The checks every committer gets, human or agent (git config core.hooksPath tools/git-hooks).
# Spec: knowledge/operations/build-and-test.md
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
status=0
check() {
    local output
    if ! output="$("$@" 2>&1)"; then
        echo "pre-commit: $* failed:"
        echo "$output" | tail -20
        status=1
    fi
}
# The knowledge base and the files agents read first.
check tools/knowledge/knowledge-check
# Docs and code linked both ways.
check tools/knowledge/doc-links
# Caps on what makes the repository expensive for agents.
check tools/repo-health/repo-health
# The canonical spec parses and links, docs cite only real IDs, generated docs are current.
check tools/axiom/axiom check
# Add your project's fast checks here (formatter, linter).
if [[ $status -ne 0 ]]; then
    echo "pre-commit: commit refused. Fix the findings above; never bypass with --no-verify."
fi
exit $status
